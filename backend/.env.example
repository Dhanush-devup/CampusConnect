# Application Configuration
APP_NAME=Internship and Placement Management System
DEBUG=True
# Anything other than "development" requires SECRET_KEY and
# INITIAL_ADMIN_PASSWORD to be changed from their defaults.
ENVIRONMENT=development

# Database Configuration
# Defaults to backend/campus_connect.db when unset.
# DATABASE_URL=sqlite:///C:/path/to/campus_connect.db

# JWT signing key. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# SECRET_KEY=

# Initial admin account created on first startup
# INITIAL_ADMIN_EMAIL=admin@campusconnect.edu
# INITIAL_ADMIN_PASSWORD=

# Browser origins allowed to call the API (JSON list)
# CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ATS resume scoring with Google Gemini (optional, free tier).
# Get a key at https://aistudio.google.com/apikey. Without a key, resumes get the
# rule-based score only. Free-tier inputs may be used by Google to improve its
# products, so use fictional demo resumes only.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
